+  padding: 16px;
+  border: 1px solid #476463;
+  border-radius: 10px;
+  margin: 12px 0;
+  text-align: left;
+}
+.study-panel p { white-space: pre-wrap; }
+.study-panel h3, .study-panel h4 { margin: 6px 0; }
