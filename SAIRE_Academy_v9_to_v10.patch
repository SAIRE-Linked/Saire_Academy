 function projectCards(){let filtered=projects.filter(p=>`${p.name} ${p.description} ${p.skills.join(' ')}`.toLowerCase().includes(search.toLowerCase()));return `<div class="page-intro"><div class="eyebrow">THE PROJECT LAB</div><h1>Don't just learn it. <span>Build it.</span></h1><p>Twelve real-world milestones designed for your engineering portfolio — and potentially SAIRE-Linked products.</p></div><div class="filter-row"><div class="search-control">⌕ <input id="search" placeholder="Search projects or technologies…" value="${safe(search)}"/></div>${chip('12 PROJECT MILESTONES')}</div><div class="projects-grid">${filtered.map(p=>`<button class="project-card" data-action="project" data-id="${p.id}"><div class="project-visual visual-${p.phase%4}"><span class="project-visual-num">${String(p.phase).padStart(2,'0')}</span><div class="project-visual-shape">⌘</div><span class="project-visual-tag">PHASE ${String(p.phase).padStart(2,'0')}</span></div><div class="project-card-body"><div class="project-card-top">${chip(p.level,'muted')}↗</div><h3>${safe(p.name)}</h3><p>${safe(p.description)}</p><div class="skill-tags">${p.skills.map(s=>`<span>${safe(s)}</span>`).join('')}</div></div></button>`).join('')}</div>`}
 function planner(){return `<div class="page-intro"><div class="eyebrow">BUILD CONSISTENCY</div><h1>Make time for <span>growth.</span></h1><p>Plan a realistic schedule around your life. Changes save automatically to this device.</p></div><div class="planner-grid"><div class="planner-main"><div class="planner-header"><div><h2>Weekly study planner</h2><p>Focused, practical sessions based on your availability.</p></div>${chip('MY WEEK','blue')}</div><div class="planner-days">${baseSchedule.map((d,i)=>`<div class="planner-day"><div class="day-icon">${d.day}</div><div class="day-body"><div><strong>${d.full}</strong><small>${d.label}</small></div><span id="minutes-${i}">${state.minutes[i]===0?'Rest':state.minutes[i]+' min'}</span><input type="range" min="0" max="240" step="15" aria-label="${d.full} study minutes" data-day="${i}" value="${state.minutes[i]}" style="background:linear-gradient(to right,#22ce9a ${state.minutes[i]/240*100}%,#203044 ${state.minutes[i]/240*100}%)"/></div></div>`).join('')}</div><div class="planner-hint">✧ Consistency beats intensity. A realistic routine that you maintain is better than an ambitious plan you abandon.</div></div><div class="planner-right"><div class="hours-card"><div class="hours-card-ring">◷</div><span>YOUR WEEKLY COMMITMENT</span><div><strong id="hours-total">${totalHours().toFixed(1)}</strong><em>hours / week</em></div><p>Learn at a pace that protects your understanding and momentum.</p></div><div class="planner-tips"><h3>Recommended rhythm</h3><div>✓ Concept before implementation</div><div>✓ Code independently every week</div><div>✓ Review and refactor your work</div><div>✓ Build projects as you progress</div></div><div class="planner-actions">${btn('Reset schedule','reset','outline')}${btn('Saved locally ✓','saved')}</div></div></div>${head('MONTH ONE','Your first four weeks','The fundamentals you will rebuild before moving ahead.')}<div class="month-grid">${weekOne.map(w=>`<div class="month-card"><span>WEEK ${String(w.week).p