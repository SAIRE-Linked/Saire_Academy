 function render(){let p={overview,roadmap,classroom,projects:projectCards,planner,resources:resourcesPage}[view]();const root=$('#app');root.innerHTML=`<div class="app-shell">${sidebar()}<div class="main-shell"><header class="topbar"><div class="topbar-left"><button class="icon-button mobile-menu" data-action="menu">☰</button><div class="breadcrumb"><span>SAIRE Academy</span><span>›</span><strong>${names[view]}</strong></div></div><div class="topbar-actions"><span class="live-badge"><span class="pulse-dot"></span> LEARNING IN PROGRESS</span><div class="top-avatar">SL</div></div></header><main class="content"><div class="page-content" style="animation:fade-in .28s ease-out">${p}</div></main><footer class="footer"><span>© 2026 SAIRE-Linked. Built smarter. Learn deeper.</span><span>Digital Learning Platform <i></i> Growth Initiative</span><button data-action="export">⇩ Back up progress</button></footer></div>${modal()}</div>${toast?`<div class="toast-demo">✓ ${safe(toast)}</div>`:''}`}
