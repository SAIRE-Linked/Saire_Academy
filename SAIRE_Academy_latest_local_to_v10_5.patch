@@ -0,0 +1,14 @@
+def transition(current, target):
+    """Both inputs must be str. Allowed: new->assigned, assigned->closed, closed->new.
+    Return target for an allowed move. All others raise ValueError (including
+    unknown, non-text, or identical states). No automatic correction.
+    """
+    raise NotImplementedError("Implement this contract")
+
+def summary(records):
+    """records must be a list of dicts with a status in new/assigned/closed.
+    Extra dictionary keys are allowed. Return all three counts as a fresh dict.
+    Empty list returns zero counts. Missing/invalid states, non-dict elements,
+    non-text status and non-list input raise ValueError. Never mutate records.
+    """
+    raise NotImplementedError("Implement this contract")
diff --git a/assignments/saire-workflow-ledger/tests/test_workflow.py b/assignments/saire-workflow-ledger/tests/test_workflow.py
new file mode 100644
--- /dev/null
+++ b/assignments/saire-workflow-ledger/tests/test_workflow.py
@@ -0,0 +1,15 @@
+import sys
+from pathlib import Path
+sys.path.append(str(Path(__file__).resolve().parents[1] / "src"))
+import unittest
+from workflow import transition, summary
+
+class WorkflowContract(unittest.TestCase):
+    def test_allowed(self):
+        self.assertEqual(transition("new", "assigned"), "assigned")
+    def test_rejected(self):
+        with self.assertRaises(ValueError): transition("new", "closed")
+    def test_count(self):
+        self.assertEqual(summary([{"status":"new"},{"status":"new"}]), {"new":2,"assigned":0,"closed":0})
+    def test_empty(self):
+        self.assertEqual(summary([]), {"new":0,"assigned":0,"closed":0})
