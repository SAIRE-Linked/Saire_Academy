# Local development. Generate a fresh strong secret for production.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-dev-only-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# DATABASE_URL=postgresql://lms_user:password@127.0.0.1:5432/saire_lms
# ProofLoop v5 worker-to-Django shared secret; at least 32 random characters.
# Set on your backend host and independent runner host using real secret storage.
# SAIRE_WORKER_SHARED_TOKEN=replace-with-random-generated-value

# SAIRE Socratic Mentor v9 - server only. NEVER use NEXT_PUBLIC_ for secrets.
# Rotate any API key that was pasted into a chat, repository, or screenshot.
SAIRE_MENTOR_PROVIDER=gemini
# GEMINI_API_KEY=paste-ROTATED-key-here-ONLY-in-backend/.env
SAIRE_GEMINI_MODEL=gemini-flash-latest
# Set to 1 for testing only with fictional learners and explicit learner consent.
# With 0, the Learning Twin is never sent to a third-party provider.
SAIRE_MENTOR_ENABLE_TWIN_CONTEXT=0

# When switching later: SAIRE_MENTOR_PROVIDER=openai
# OPENAI_API_KEY=paste-your-NEW-private-key-here
SAIRE_OPENAI_MODEL=gpt-6-luna

# v10 OAuth: set credentials here, never in NEXT_PUBLIC_* variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SAIRE_SUPPLEMENTARY_GRADE_CAP=70
# Include the frontend public HTTPS origin in production.
# CSRF_TRUSTED_ORIGINS=https://academy.example.com

# Trust the Next.js proxy forwarded host for correct OAuth callback origin.
# Backend must be private/firewalled in production when this is enabled.
DJANGO_USE_X_FORWARDED_HOST=1

# Change the orientation version when the Handbook rules materially change.
# SAIRE_ORIENTATION_VERSION=2026-11-v1
# SAIRE_SUPPORT_EMAIL=academy-support@example.edu
